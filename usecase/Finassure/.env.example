# FinAssure Configuration
# Paste your Gemini API key below:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model names (defaults to gemini-2.5-flash / gemini-2.5-pro or gemini-1.5-flash)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Server config
PORT=8000
HOST=127.0.0.1
DEBUG=true
